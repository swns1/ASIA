__pycache__/
*.pyc
*.pyo
*.pyd
.env
# Vite's per-machine overrides (frontend/admin-portal/.env.local): the API URLs
# for whichever network this machine is on. Never committed -- they are local
# addresses, and a stale one silently breaks the next person's build.
.env.local
.env.*.local
# The phone-testing template, which carries whatever address this machine had.
.env.phone-test
.Python
backend/student-service/students/env

# Local review documents — not for commit
_review/

# Dependencies (previously untracked-but-not-ignored — see git rm --cached step)
node_modules/
.venv/

# OS / editor
.DS_Store

# Build output
dist/
dist-ssr/

# Django uploaded media (was landing in source tree before the MEDIA_ROOT fix)
media/

# whitenoise/collectstatic output -- regenerated on every deploy, see
# STATIC_ROOT in each service's settings.py.
staticfiles/

# Django FileBasedCache (DRF throttle counters) -- see CACHES in each
# service's settings.py. Local, disposable, per-machine.
cache/

# Rotated application logs -- see LOGGING in each service's settings.py
# (shared/logging_config.py). Local, disposable, per-machine; may contain
# request paths/metadata that shouldn't be committed.
logs/

# scripts/backup.ps1 output -- a full database dump plus every uploaded
# student document. Never commit it.
backups/

# Machine-local tool state, committed by accident. `.semgrep/guardian.yml` is
# semgrep's own CLI settings file (an anonymous install id and a login expiry),
# not a rule file -- nothing in the project reads it and semgrep isn't wired
# into CI. It differs per machine, so tracking it just produces conflicts.
.semgrep/

# Claude Code's per-machine settings. This holds API keys and local DB
# passwords. It was only ever kept out of commits by a global ~/.config/git
# ignore rule, which nobody else cloning this repo has -- so ignore it here,
# where the protection travels with the project.
.claude/settings.local.json

# Scanned documents used for OCR development. These are real civil-registry
# records of named individuals -- sensitive personal information under RA
# 10173 -- and nothing in the codebase reads them, so they must never be
# committed. Keep local copies here for development instead.
OCR_IMAGES/
backend/student-service/students/fixtures/*.jpg
frontend/admin-portal/MAROON_HIGHLIGHT_PLAN.md
