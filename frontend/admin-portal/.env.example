# Optional for local development — every api/*.js already falls back to the
# localhost defaults below, so `npm run dev` works with no .env at all.
#
# REQUIRED for a production build. `vite build` aborts if any of the four
# service URLs is unset, because without them the bundle silently ships
# pointing at localhost and every API call fails once deployed. Put the real
# values in .env.production, or set them in the build environment.
VITE_IDENTITY_API_URL=http://localhost:8001/api/auth
VITE_STUDENT_API_URL=http://localhost:8000/api
VITE_BILLING_API_URL=http://localhost:8002/api
VITE_ENROLLMENT_API_URL=http://localhost:8003/api

# Genuinely optional override. Falls back to <VITE_IDENTITY_API_URL>/audit-logs/.
VITE_AUDIT_API_URL=
