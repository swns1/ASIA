# Serves the built admin portal (frontend/admin-portal/Dockerfile).
# Railway terminates HTTPS and sets PORT; Caddy only needs plain HTTP here.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change under the same name.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# The entry page must always be re-checked, or a redeploy leaves open
	# tabs requesting chunks that no longer exist.
	@shell path / /index.html
	header @shell Cache-Control "no-cache"

	# Client-side routes (/requirements, /apply/<id>, ...) all load the app.
	try_files {path} /index.html
	file_server
}
