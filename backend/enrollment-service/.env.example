# Copy this file to .env in the same directory and fill in real values.
# SECRET_KEY MUST be identical across all four backend/*/.env files —
# SimpleJWT signs/verifies tokens with it.
SECRET_KEY=

# DEBUG defaults to off (safe for a real deployment) unless set to 1 here.
# Set it for local development, where you want real error pages instead of
# a generic 500. ALLOWED_HOSTS is a comma-separated list; "*" here is
# dev-only and also what lets a phone on the same LAN reach this service by
# IP during testing — set it to your real domain name(s) in production.
DEBUG=1
ALLOWED_HOSTS=*

DB_NAME=SLIS THESIS FINAL
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Number of reverse proxies in front of this service. Leave at 0 (the
# default) for local development and any setup with no proxy: DRF trusts
# X-Forwarded-For for exactly this many hops, so a non-zero value with no
# real proxy lets a client spoof its own rate-limit bucket and the IP
# recorded in the audit log. Set to 1 when deploying behind a single load
# balancer.
NUM_PROXIES=0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / third-party integrations used by the ai/ and enrollments/ apps.
# Rotate these at the provider dashboard before reusing — see instructions doc.
GEMINI_API_KEY=
GROQ_API_KEY=

# Where uploaded requirement documents are stored. Defaults to this service's
# own media/ folder. Student- and enrollment-service both store documents, so
# for a deployment point BOTH at the same folder (absolute path), e.g.
#   MEDIA_ROOT=C:\SLIS-Data\media
# and include that folder in backups (scripts/backup.ps1 reads this value).
# MEDIA_ROOT=

# Enrollment confirmation email (enrollments/email_views.py), sent over SMTP.
# Default is a Gmail / Google Workspace mailbox:
#   1. Turn on 2-Step Verification for the account.
#   2. Google Account > Security > App passwords > create one for "SLIS".
#   3. Put the account in EMAIL_HOST_USER and the 16-letter app password
#      (no spaces) in EMAIL_HOST_PASSWORD — never the normal password.
# Gmail sends up to ~500 messages/day (Workspace ~2,000) to any address.
# This machine needs internet access on port 587 even for a LAN deployment.
# Leave EMAIL_HOST_USER blank to switch email off; enrollment still works and
# staff see "the confirmation email could not be sent".
# Any other SMTP provider works by changing EMAIL_HOST / EMAIL_PORT.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional; defaults to "South Lakes Integrated School <EMAIL_HOST_USER>".
# Gmail rewrites the From address to the signed-in account anyway.
# DEFAULT_FROM_EMAIL=South Lakes Integrated School <registrar@example.com>
# Development only — print emails to the terminal instead of sending:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# -- LAN testing deployment ---------------------------------------------------
# For a deployment other devices actually reach (see "Deployment" in
# README.md), change the values above to:
#
#   DEBUG=0
#   ALLOWED_HOSTS=<this machine's LAN IP>    # "*" is dev-only
#   CORS_ALLOWED_ORIGINS=http://<LAN IP>:<port the frontend is served on>
#
# ALLOWED_HOSTS is not optional once DEBUG=0: an empty list rejects every
# request, which looks like the service being down.
#
# The SECURE_* settings are opt-in and OFF by default because nothing in this
# stack terminates TLS yet. Leave them off for a plain-HTTP LAN run --
# SECURE_SSL_REDIRECT=1 without HTTPS makes every page unreachable. Turn them
# on together the day a real certificate sits in front of this:
#
#   SECURE_SSL_REDIRECT=1
#   SESSION_COOKIE_SECURE=1
#   CSRF_COOKIE_SECURE=1
#   SECURE_HSTS_SECONDS=31536000
#   SECURE_HSTS_INCLUDE_SUBDOMAINS=1
#   SECURE_HSTS_PRELOAD=1
#
# NUM_PROXIES stays 0 for a direct LAN run; set it to 1 only behind a real
# load balancer or reverse proxy.
