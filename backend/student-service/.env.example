# Copy this file to .env in the same directory and fill in real values.
# SECRET_KEY MUST be identical across all four backend/*/.env files —
# SimpleJWT signs/verifies tokens with it.
SECRET_KEY=

# DEBUG defaults to off (safe for a real deployment) unless set to 1 here.
# Set it for local development, where you want real error pages instead of
# a generic 500. ALLOWED_HOSTS is a comma-separated list; "*" here is
# dev-only and also what lets a phone on the same LAN reach this service by
# IP during testing — set it to your real domain name(s) in production.
DEBUG=1
ALLOWED_HOSTS=*

DB_NAME=SLIS THESIS FINAL
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Number of reverse proxies in front of this service. Leave at 0 (the
# default) for local development and any setup with no proxy: DRF trusts
# X-Forwarded-For for exactly this many hops, so a non-zero value with no
# real proxy lets a client spoof its own rate-limit bucket and the IP
# recorded in the audit log. Set to 1 when deploying behind a single load
# balancer.
NUM_PROXIES=0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=
GROQ_API_KEY=

# Used to build the /apply/<invite_id> link sent to applicants (see
# intake/views.py). Set this to wherever the frontend is actually reachable
# from an applicant's own device — localhost only works for a front-desk
# device on the same machine as this backend.
FRONTEND_BASE_URL=http://localhost:5173

# Resend (https://resend.com) — used to email applicants their form link
# (never the access code; see intake/emails.py). Leave blank in local dev:
# a missing key just means invite emails aren't sent, and the link/code are
# always shown on screen to the issuing staff member regardless.
RESEND_API_KEY=

# Applicant intake (backend/student-service/intake/) — sensible defaults
# baked in; only set these to override.
# APPLICATION_INVITE_TTL_SECONDS=259200
# APPLICANT_SESSION_TTL_SECONDS=7200

# -- LAN testing deployment ---------------------------------------------------
# For a deployment other devices actually reach (see "Deployment" in
# README.md), change the values above to:
#
#   DEBUG=0
#   ALLOWED_HOSTS=<this machine's LAN IP>    # "*" is dev-only
#   CORS_ALLOWED_ORIGINS=http://<LAN IP>:<port the frontend is served on>
#
# ALLOWED_HOSTS is not optional once DEBUG=0: an empty list rejects every
# request, which looks like the service being down.
#
# The SECURE_* settings are opt-in and OFF by default because nothing in this
# stack terminates TLS yet. Leave them off for a plain-HTTP LAN run --
# SECURE_SSL_REDIRECT=1 without HTTPS makes every page unreachable. Turn them
# on together the day a real certificate sits in front of this:
#
#   SECURE_SSL_REDIRECT=1
#   SESSION_COOKIE_SECURE=1
#   CSRF_COOKIE_SECURE=1
#   SECURE_HSTS_SECONDS=31536000
#   SECURE_HSTS_INCLUDE_SUBDOMAINS=1
#   SECURE_HSTS_PRELOAD=1
#
# NUM_PROXIES stays 0 for a direct LAN run; set it to 1 only behind a real
# load balancer or reverse proxy.
